---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索" noindex={true}>
  <section class="sect">
    <div class="sect-head">
      <h1 data-i18n="search.title">搜索</h1>
      <span class="en">Search</span>
    </div>
    <p class="lead" data-i18n="search.desc">搜索文章标题、标签和摘要</p>

    <div class="search-box">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        id="searchInput"
        class="search-input"
        placeholder="输入关键词搜索..."
        autocomplete="off"
        autofocus
        aria-label="搜索"
        data-i18n-aria="search.title"
        data-i18n-placeholder="search.placeholder"
      />
      <button
        class="search-clear"
        id="searchClear"
        aria-label="清除搜索"
        data-i18n-aria="search.clear"
        type="button"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <p class="search-info" id="searchInfo" role="status" aria-live="polite" aria-atomic="true"></p>
  </section>

  <ul class="rows search-results" id="searchResults"></ul>
  <p class="note" id="searchEmpty" data-i18n="search.empty">输入关键词开始搜索</p>
</BaseLayout>

<script>
  (function () {
    interface SearchPost {
      id: string;
      title: string;
      date: string;
      tags: string[];
      minutes: number;
      excerpt: string;
    }

    const input = document.getElementById('searchInput') as HTMLInputElement;
    const results = document.getElementById('searchResults')!;
    const info = document.getElementById('searchInfo')!;
    const empty = document.getElementById('searchEmpty')!;
    const clearBtn = document.getElementById('searchClear')!;
    let index: SearchPost[] = [];
    let indexState: 'loading' | 'ready' | 'failed' = 'loading';
    let timer: ReturnType<typeof setTimeout>;

    // 这三条和 BaseLayout 里 DICT 的同名键保持一致：那边管结构内文本，
    // 这里管结果行这种由脚本动态写入的文本
    const DICT: Record<string, Record<string, string>> = {
      zh: {
        'search.resultCount': '找到 {0} 篇文章',
        'search.noResult': '没有找到相关文章',
        'search.loadError': '搜索索引加载失败',
        'search.recent': '最近更新',
        'search.loading': '正在载入索引…',
        'search.resultOne': '找到 {0} 篇文章',
        'post.minutes': '{0} 分钟',
      },
      en: {
        'search.resultCount': '{0} posts found',
        'search.noResult': 'No posts found',
        'search.loadError': 'Failed to load the search index',
        'search.recent': 'Recent',
        'search.loading': 'Loading index…',
        'search.resultOne': '1 post found',
        'post.minutes': '{0} min',
      },
    };

    function currentLang(): string {
      return document.documentElement.dataset.lang === 'en' ? 'en' : 'zh';
    }

    function t(key: string, args: string[]): string {
      let tmpl = DICT[currentLang()]?.[key] || key;
      args.forEach((arg, i) => {
        tmpl = tmpl.replace('{' + i + '}', arg);
      });
      return tmpl;
    }

    /** 把命中的关键词包进 <mark>；退出时由浏览器按文本还原 */
    function highlight(text: string, query: string): string {
      if (!query) return text;
      const words = query.trim().split(/\s+/).filter(Boolean);
      let result = text;
      words.forEach((w) => {
        const re = new RegExp('(' + w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
        result = result.replace(re, '<mark>$1</mark>');
      });
      return result;
    }

    function escapeHtml(text: string): string {
      return text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function row(post: SearchPost, query: string): string {
      const title = highlight(escapeHtml(post.title), query);
      const excerpt = post.excerpt ? highlight(escapeHtml(post.excerpt), query) : '';
      return (
        '<li class="row">' +
        '<div class="row-main">' +
        '<h2><a href="/posts/' +
        encodeURIComponent(post.id) +
        '">' +
        title +
        '</a></h2>' +
        (excerpt ? '<p>' + excerpt + '</p>' : '') +
        '</div>' +
        '<div class="row-meta"><time datetime="' +
        post.date +
        '">' +
        post.date +
        '</time><span>' +
        t('post.minutes', [String(post.minutes)]) +
        '</span>' +
        (post.tags.length
          ? '<span class="row-tags">' +
            post.tags
              .slice(0, 2)
              .map((tag) => '<span class="tag tag--static">' + escapeHtml(tag) + '</span>')
              .join('') +
            '</span>'
          : '') +
        '</div>' +
        '</li>'
      );
    }

    /** 空查询：不留一片空白，直接给出最近 8 篇当入口 */
    function showRecent(): void {
      if (indexState !== 'ready' || index.length === 0) {
        results.innerHTML = '';
        info.textContent = indexState === 'failed' ? t('search.loadError', []) : '';
        empty.style.display = 'block';
        return;
      }
      empty.style.display = 'none';
      info.textContent = t('search.recent', []);
      results.innerHTML = index
        .slice(0, 8)
        .map((post) => row(post, ''))
        .join('');
    }

    function search(query: string): void {
      if (!query.trim()) {
        clearBtn.classList.remove('visible');
        showRecent();
        return;
      }

      clearBtn.classList.add('visible');

      // 索引还没到就别下结论：否则会笃定地告诉读者「没有找到」
      if (indexState === 'loading') {
        info.textContent = t('search.loading', []);
        results.innerHTML = '';
        return;
      }
      if (indexState === 'failed') {
        info.textContent = t('search.loadError', []);
        results.innerHTML = '';
        return;
      }

      const words = query.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const filtered = index.filter((post) => {
        const haystack = (
          post.title +
          ' ' +
          post.tags.join(' ') +
          ' ' +
          post.excerpt
        ).toLowerCase();
        return words.every((w) => haystack.indexOf(w) !== -1);
      });

      empty.style.display = 'none';

      if (filtered.length === 0) {
        info.textContent = t('search.noResult', []);
        results.innerHTML = '';
        return;
      }

      info.textContent =
        filtered.length === 1
          ? t('search.resultOne', [String(filtered.length)])
          : t('search.resultCount', [String(filtered.length)]);
      results.innerHTML = filtered.map((post) => row(post, query)).join('');
    }

    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        search(input.value);
      }, 200);
    });

    clearBtn.addEventListener('click', () => {
      input.value = '';
      search('');
      input.focus();
    });

    // 切换中英文时把已经渲染出来的结果行重画一遍（BaseLayout 改的是 <html data-lang>）
    new MutationObserver(() => {
      // 空查询时也要重画，否则「最近更新」停在切换前的语言上
      if (input.value.trim()) search(input.value);
      else showRecent();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-lang'] });

    fetch('/search.json')
      .then((res) => res.json())
      .then((data) => {
        index = data;
        indexState = 'ready';
        // 索引就绪前敲的字不能丢：补算一遍，否则会一直停在「没有找到」
        if (input.value.trim()) search(input.value);
        else showRecent();
      })
      .catch(() => {
        indexState = 'failed';
        info.textContent = t('search.loadError', []);
        // 属性也一起换掉，否则切语言时会被 applyLang 覆写回「输入关键词开始搜索」
        empty.setAttribute('data-i18n', 'search.loadError');
        empty.textContent = t('search.loadError', []);
      });
  })();
</script>
